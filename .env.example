# Copy to .env. Every value here is a local default; production supplies its own via the
# platform's secret manager and is validated by Settings._validate on startup.

ENVIRONMENT=local

# --- Postgres (system of record) -------------------------------------------------------------
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
# 5433 because the sibling AI-Agent-Customer-Support-RAG stack owns 5432.
POSTGRES_PORT=5433

# --- OpenSearch (BM25 + dense kNN, one engine) ------------------------------------------------
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_VERIFY_CERTS=false
# Production: 31g, just under the compressed-oops threshold, on dedicated data nodes.
# Heap size only -- the image already selects G1; a second collector here refuses to boot.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
# Set true ONLY on a developer machine that runs near a full disk. See docker-compose.yml.
OS_DISK_WATERMARKS_DISABLED=false

# --- Redis (rate limits, query cache, principal cache) ----------------------------------------
REDIS_PASSWORD=erp

# --- Auth --------------------------------------------------------------------------------------
JWT_SECRET=local-development-secret-change-me-32chars
COOKIE_SECURE=false

# --- Providers ---------------------------------------------------------------------------------
# The offline triple: no paid API, no model download, deterministic. This is what CI runs, and
# what makes the ablation table runnable on every pull request.
LLM_PROVIDER=none              # none | anthropic | openai
EMBEDDING_PROVIDER=hashing     # hashing | onnx | openai | bedrock
# `hashing` has NO semantic understanding -- it matches paraphrases only by shared vocabulary,
# so the dense leg contributes far less than it does in production. It is the CI and offline
# default because it needs no model and is byte-identical across runs.
#
# For real retrieval: docker compose --profile models up, then EMBEDDING_PROVIDER=onnx.
# The embedder id and dimension are then read FROM the running service, because both enter the
# generation fingerprint and must describe what actually produced the vectors.
# MODELS_SERVICE_URL=http://models:8000
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_PROVIDER=identity     # identity | lexical | onnx | cohere | voyage | jina
CONTEXTUALIZER=template        # template | llm

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Set when running `docker compose --profile models up` / `--profile parse up`.
# MODELS_SERVICE_URL=http://models:8000
# PARSER_SERVICE_URL=http://parser:8000

# --- Ports ---------------------------------------------------------------------------------------
API_PORT=8001
MODELS_PORT=8002
PARSER_PORT=8003
KEYCLOAK_PORT=8081
