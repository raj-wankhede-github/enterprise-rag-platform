{
  "char_filter": {
    "smart_punct": {
      "type": "mapping",
      "mappings": [
        "\\u2019=>'",
        "\\u2018=>'",
        "\\u201C=>\"",
        "\\u201D=>\"",
        "\\u2013=>-",
        "\\u2014=>-",
        "\\u00A0=>\\u0020"
      ]
    }
  },
  "tokenizer": {
    "heading_path_tokenizer": {
      "type": "path_hierarchy",
      "delimiter": ">"
    }
  },
  "filter": {
    "en_possessive": {
      "type": "stemmer",
      "language": "possessive_english"
    },
    "en_stop": {
      "type": "stop",
      "stopwords": "_english_"
    },
    "en_stem_light": {
      "type": "stemmer",
      "language": "light_english"
    },
    "code_split": {
      "type": "word_delimiter_graph",
      "generate_word_parts": true,
      "generate_number_parts": true,
      "catenate_words": true,
      "catenate_numbers": true,
      "catenate_all": true,
      "split_on_case_change": false,
      "split_on_numerics": true,
      "preserve_original": true,
      "stem_english_possessive": false
    },
    "dedupe_positions": {
      "type": "unique",
      "only_on_same_position": true
    }
  },
  "normalizer": {
    "lc_ascii": {
      "type": "custom",
      "char_filter": ["smart_punct"],
      "filter": ["lowercase", "asciifolding"]
    }
  },
  "analyzer": {
    "text_en": {
      "type": "custom",
      "char_filter": ["smart_punct"],
      "tokenizer": "standard",
      "filter": ["lowercase", "asciifolding", "en_possessive", "en_stop", "en_stem_light"]
    },
    "text_exact": {
      "type": "custom",
      "char_filter": ["smart_punct"],
      "tokenizer": "whitespace",
      "filter": ["code_split", "lowercase", "asciifolding", "flatten_graph", "dedupe_positions"]
    },
    "heading_path_tree": {
      "type": "custom",
      "tokenizer": "heading_path_tokenizer",
      "filter": ["lowercase", "asciifolding"]
    }
  }
}
